# Discord application credentials
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_client_id
GUILD_ID=your_test_server_id
VERIFIED_ROLE_ID=1543986189676191744

# Support tickets: category channel ID, comma-separated staff role IDs, and optional HTTPS banner URL.
TICKET_CATEGORY_ID=
TICKET_SUPPORT_ROLE_IDS=
TICKET_PANEL_BANNER_URL=

# OpenAI settings used by /ask, +ask, +summarize, and the 1tf reply feature.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public wallet and read-only provider settings
COINGECKO_API_KEY=
WALLET_ADDRESS=
WALLET_NETWORK=
WALLET_COIN=ETH
WALLET_PRICE_ID=ethereum
WALLET_ASSETS_JSON=[]
EXPLORER_API_KEY=
EXPLORER_API_URL=
PAYMENT_INSTRUCTIONS=
REWARD_MESSAGE=Rewards are informational only. This bot never sends funds.

# Persistent login-time and user-wallet storage
DATABASE_PATH=./data/leonidas.sqlite
TIMEZONE=Asia/Kolkata
